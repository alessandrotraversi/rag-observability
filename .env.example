# --- Domain ---------------------------------------------------------------------
RAG_PROFILE=profiles/fcai-saas-support/profile.yaml
RAG_DATA_DIR=data
RAG_FEATURE=rag_chat

# --- Providers (any LangChain provider; install its integration package) ----------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0
# LLM_API_KEY=              # optional: otherwise the provider's own env var is used
OPENAI_API_KEY=

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=

# pgvector | memory | package.module:Factory
VECTOR_STORE=pgvector
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/rag_db

# --- Observability ----------------------------------------------------------------
APP_ENV=development
OBSERVABILITY_ENABLED=false
OBSERVABILITY_SAMPLE_RATE=1.0
OBSERVABILITY_CAPTURE_CONTENT=false
OTEL_SERVICE_NAME=rag-observability
OTEL_TRACES_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# auto | generic | langfuse
OTEL_BACKEND=auto
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- Governance -------------------------------------------------------------------
AI_ALLOWED_MODELS=gpt-4.1-mini
AI_MONTHLY_BUDGET_USD=10.0
AI_MAX_OUTPUT_TOKENS=1200
# jsonl | memory | none | package.module:Factory
AI_USAGE_LEDGER=jsonl
AI_USAGE_LEDGER_PATH=data/ai_usage.jsonl
AI_PRICING_PATH=config/pricing.yaml

# --- API --------------------------------------------------------------------------
# Only behind a trusted gateway that sets X-RAG-Scope-<field> from the auth identity.
API_SCOPE_FROM_HEADERS=false
